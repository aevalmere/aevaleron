// The agents notification (renderer/agents.html): the head is the session
// that just changed, with its state dot, its name and where it runs, and one
// line of its message that opens to eight when the pointer rests on it.
// Under a hairline, every session with what it started nested under it,
// each with its own state and time. A click goes to that agent's window; a
// right click puts it away. The window is the card (opaque), so it never
// takes the keyboard and nothing here needs focus.

import { Theme } from "theme.slint";

export struct AgentRow {
    name: string,
    place: string,
    // Its own time: "working 12m", "done 3m ago".
    text: string,
    // "working", "done" or "needs-you".
    state: string,
    // Nested under the row above it, and the last of those.
    child: bool,
    last: bool,
    // Its children follow.
    parent: bool,
    // The "N more in the tray menu" line, its words in `text`.
    more: bool,
}

component Key inherits Rectangle {
    in property <string> text;

    width: max(24px, key-text.preferred-width + 8px);
    height: key-text.preferred-height + 2px;
    border-radius: Theme.r-key;
    background: Theme.fill-1;

    key-text := Text {
        text: root.text;
        font-size: Theme.meta;
        color: Theme.label-2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A branch line of the tree.
component Branch inherits Rectangle {
    background: Theme.slate-mist;
}

export component AgentsWindow inherits Window {
    background: Theme.base;
    default-font-family: Theme.font;

    // "done", "needs-you" or "info" (the app's own messages: no dot).
    in property <string> kind: "info";
    // Not `title`: that is the window's own.
    in property <string> head-title;
    in property <string> place;
    in property <string> detail;
    in property <bool> alt-tab: false;
    in property <[AgentRow]> rows;
    // The head's own children hang from under its dot.
    in property <bool> stem: false;
    // The pointer is on the card.
    in property <bool> hover: false;
    // The whole message shows.
    in property <bool> open: false;
    // Lifting away: the words go before the window does.
    in property <bool> leaving: false;

    // How tall the card is now, and whether the message has more lines.
    out property <length> content-height: col.preferred-height;
    out property <bool> can-open: root.detail != "" && full.preferred-height > line.preferred-height + 1px;

    callback open-head();
    callback open-row(int);
    callback dismiss();

    property <length> dot-x: 16px;
    property <length> text-x: 32px;
    property <length> row-line: 20px * Theme.text-scale;
    property <length> head-right: root.alt-tab ? Theme.sp-4 + keys-row.preferred-width + Theme.sp-3 : Theme.sp-4;
    property <length> head-avail: root.width - root.text-x - root.head-right;
    property <string> sep: "\u{b7}\u{a0}\u{a0}";

    // Measures for the message: one line, and all of it wrapped.
    line := Text {
        opacity: 0;
        text: "X";
        font-size: Theme.caption;
    }

    full := Text {
        opacity: 0;
        width: root.head-avail;
        text: root.detail;
        font-size: Theme.caption;
        wrap: word-wrap;
    }

    Rectangle {
        width: root.width;
        height: root.height;
        background: root.hover ? Theme.raised : Theme.base;
        animate background { duration: Theme.fast; }
    }

    Rectangle {
        width: root.width;
        height: root.height;
        opacity: root.leaving ? 0 : 1;
        animate opacity { duration: Theme.reduced-motion ? 0ms : 220ms; }

        col := VerticalLayout {
            alignment: start;

            head := Rectangle {
                height: head-col.preferred-height;

                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => {
                        root.open-head();
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                            root.dismiss();
                        }
                    }
                }

                // Finished or needs you.
                if root.kind != "info": Rectangle {
                    x: root.dot-x;
                    y: Theme.sp-3 + root.row-line / 2 - 4px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.kind == "needs-you" ? Theme.blush : Theme.slate-soft;
                }

                if root.stem: Branch {
                    x: root.dot-x + 4px;
                    y: Theme.sp-3 + root.row-line / 2 + 7px;
                    width: 1px;
                    height: max(0px, parent.height - self.y);
                }

                head-col := VerticalLayout {
                    padding-top: Theme.sp-3;
                    padding-bottom: Theme.sp-3;
                    padding-left: root.text-x;
                    padding-right: root.head-right;

                    HorizontalLayout {
                        spacing: 5px;
                        height: root.row-line;

                        // The app shrinks first, to a stub, before the name does.
                        title-text := Text {
                            width: max(0px, min(self.preferred-width, root.head-avail - place-text.width - 5px));
                            text: root.head-title;
                            font-size: Theme.row;
                            font-weight: 600;
                            color: Theme.label;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        place-text := Text {
                            property <length> want: root.place == "" ? 0px : self.preferred-width;
                            width: min(self.want, max(min(64px, self.want), root.head-avail - title-text.preferred-width - 5px));
                            visible: root.place != "";
                            text: root.sep + root.place;
                            font-size: Theme.caption;
                            color: Theme.label-2;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    // One line closed, up to eight open.
                    if root.detail != "": Rectangle {
                        height: root.open ? min(full.preferred-height, 8 * line.preferred-height) : line.preferred-height;
                        clip: true;
                        animate height { duration: Theme.morph; }

                        if !root.open: Text {
                            width: parent.width;
                            height: line.preferred-height;
                            text: root.detail;
                            font-size: Theme.caption;
                            color: Theme.label-2;
                            overflow: elide;
                        }

                        if root.open: Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.detail;
                            font-size: Theme.caption;
                            color: Theme.label-2;
                            wrap: word-wrap;
                            overflow: elide;
                        }
                    }
                }

                // Alt and Tab, while Alt+Tab would jump somewhere.
                Rectangle {
                    visible: root.alt-tab;
                    x: parent.width - Theme.sp-4 - self.width;
                    y: Theme.sp-3;
                    width: keys-row.preferred-width;
                    height: root.row-line;

                    keys-row := HorizontalLayout {
                        spacing: Theme.sp-1;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Key {
                                text: "Alt";
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Key {
                                text: "Tab";
                            }
                        }
                    }
                }
            }

            // Every session under a hairline, with what it started under it.
            if root.rows.length > 0: VerticalLayout {
                padding-bottom: Theme.sp-2;

                HorizontalLayout {
                    padding-left: Theme.sp-4;
                    padding-right: Theme.sp-4;
                    Rectangle {
                        height: 1px;
                        background: Theme.hairline;
                    }
                }

                Rectangle {
                    height: 4px;
                    if root.stem: Branch {
                        x: root.dot-x + 4px;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                    }
                }

                for r[i] in root.rows: Rectangle {
                    height: line.preferred-height + (r.child ? 6px : 10px);

                    row-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: r.more ? MouseCursor.default : MouseCursor.pointer;
                        clicked => {
                            if (!r.more) {
                                root.open-row(i);
                            }
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                root.dismiss();
                            }
                        }
                    }

                    Rectangle {
                        x: Theme.sp-2;
                        width: parent.width - 2 * Theme.sp-2;
                        height: parent.height;
                        border-radius: Theme.r-row;
                        background: row-touch.has-hover && !r.more ? Theme.fill-1 : transparent;
                    }

                    // The branches: a line down from under a session's dot, an
                    // arm out to each of its children's dots.
                    if r.parent: Branch {
                        x: root.dot-x + 4px;
                        y: parent.height / 2 + 7px;
                        width: 1px;
                        height: max(0px, parent.height / 2 - 7px);
                    }

                    if r.child: Branch {
                        x: root.dot-x + 4px;
                        y: 0px;
                        width: 1px;
                        height: r.last ? parent.height / 2 + 1px : parent.height;
                    }

                    if r.child: Branch {
                        x: root.dot-x + 4px;
                        y: parent.height / 2;
                        width: root.text-x - root.dot-x - 4px;
                        height: 1px;
                    }

                    if !r.more: Rectangle {
                        x: r.child ? root.text-x : root.dot-x;
                        y: (parent.height - self.height) / 2;
                        width: r.child ? 6px : 8px;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: r.state == "working" ? transparent : r.state == "needs-you" ? Theme.blush : Theme.slate-soft;
                        border-width: r.state == "working" ? 1.5px : 0px;
                        border-color: Theme.label-2;
                    }

                    if r.more: Text {
                        x: root.text-x;
                        y: (parent.height - self.height) / 2;
                        text: r.text;
                        font-size: Theme.meta;
                        color: Theme.label-2;
                    }

                    // The name, where it runs (which gives way first, to a stub)
                    // and its own time at the right.
                    if !r.more: words := Rectangle {
                        property <length> left: r.child ? root.text-x + 14px : root.text-x;
                        property <length> avail: self.width - self.left - Theme.sp-4 - Theme.sp-3 - 5px;
                        property <length> host-want: r.place == "" ? 0px : host-text.preferred-width;
                        property <length> host-w: min(self.host-want, max(min(64px, self.host-want), self.avail - name-text.preferred-width - status-text.preferred-width));

                        width: parent.width;
                        height: parent.height;

                        HorizontalLayout {
                            padding-left: words.left;
                            padding-right: Theme.sp-4;
                            spacing: 5px;

                            name-text := Text {
                                width: max(0px, min(self.preferred-width, words.avail - words.host-w - status-text.preferred-width));
                                text: r.name;
                                font-size: Theme.caption;
                                color: Theme.label;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            host-text := Text {
                                width: words.host-w;
                                visible: r.place != "";
                                text: root.sep + r.place;
                                font-size: Theme.meta;
                                color: Theme.label-2;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            status-text := Text {
                                text: r.text;
                                font-size: Theme.meta;
                                font-weight: r.state == "needs-you" ? 600 : 400;
                                color: r.state == "needs-you" ? Theme.label : Theme.label-2;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
