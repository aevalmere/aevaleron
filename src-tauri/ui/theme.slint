// DESIGN.md v2.2 without the glass, in Aevalsistant's colours
// (aevalsistant docs/DESIGN.md): warm paper, ink titles, slate secondary
// text and controls, blush for what needs you, the maroon clip for what
// destroys. Like Aevalsistant it is paper whatever Windows' app theme is
// (ui::dark() is always false); the dark values stay for a later choice.
// Same type ramp, radii and 4-grid spacing. Every page window sets
// `text-scale` (Windows' text size times the app's own, ui:text-scale).
// Contrast on paper: ink 11.2:1, slate 5.1:1, label-3 4.9:1, clip 6.1:1.

export global Theme {
    in-out property <bool> dark: false;
    in-out property <float> text-scale: 1.0;

    // Surfaces: paper, a touch lighter for raised, the keycap tone for plates.
    out property <color> base: dark ? #1A2331 : #FFF6F1;
    out property <brush> body: dark ? @linear-gradient(180deg, #2A3545 0%, #1A2331 100%) : @linear-gradient(180deg, #FFF9F6 0%, #FFF6F1 100%);
    out property <color> raised: dark ? #2A3545 : #FFFBF8;
    out property <color> plate: dark ? #222C3B : #FBEBE3;

    // Labels: ink, slate, a softer slate.
    out property <color> label: dark ? #F7F3EA : #3E3438;
    out property <color> label-2: dark ? #C9D4E2 : #586C7D;
    out property <color> label-3: dark ? #B4BFCE : #5E6F7E;

    // Fills: warm ink washes on paper (hover, pressed, chips).
    out property <color> fill-1: dark ? #F7F3EA12 : #8E4A520A;
    out property <color> fill-2: dark ? #F7F3EA1F : #8E4A5212;
    out property <color> fill-3: dark ? #F7F3EA2E : #8E4A521C;
    // Paper edge: the card hairline and separators.
    out property <color> hairline: dark ? #F7F3EA1A : #F0DDD3;

    // Accent: slate for controls (switches, the prominent button, focus).
    out property <color> accent: dark ? #A9C6E4 : #586C7D;
    out property <color> accent-text: dark ? #CFE0F1 : #586C7D;
    out property <color> on-accent: dark ? #16202D : #FFF6F1;
    out property <color> accent-wash: dark ? #A9C6E42E : #586C7D1F;
    out property <color> signal: dark ? #5E86B4 : #46586A;
    // Blush: the "needs you" dot and the selection.
    out property <color> blush: #E9A9AE;
    // Slate hair: the "done" dot, and the elbows under a session.
    out property <color> slate-soft: dark ? #9DB0B9 : #9DB0B9;
    out property <color> slate-mist: dark ? #586C7D : #C9D5DA;
    out property <color> danger: dark ? #F2A0A8 : #8E4A52;
    out property <color> focus-ring: dark ? #CFE0F1 : #586C7D;
    out property <color> selection: dark ? #A9C6E466 : #E9A9AE66;

    // Type ramp (size / line height), scaled with the text size.
    out property <length> meta: 12px * text-scale;
    out property <length> caption: 13px * text-scale;
    out property <length> row: 14px * text-scale;
    out property <length> body-size: 15px * text-scale;
    out property <length> body-line: 24px * text-scale;
    out property <length> title: 17px * text-scale;
    out property <length> bar-size: 18px * text-scale;
    out property <length> page: 22px * text-scale;
    out property <length> code: 13px * text-scale;

    out property <string> font: "Segoe UI Variable Text";
    out property <string> mono: "Cascadia Mono";
    out property <string> icons: "Segoe MDL2 Assets";

    // Radii.
    out property <length> r-sheet: 28px;
    out property <length> r-card: 16px;
    out property <length> r-plate: 12px;
    out property <length> r-row: 8px;
    out property <length> r-key: 6px;

    // Spacing.
    out property <length> sp-1: 4px;
    out property <length> sp-2: 8px;
    out property <length> sp-3: 12px;
    out property <length> sp-4: 16px;
    out property <length> sp-5: 24px;
    out property <length> sp-6: 32px;

    // Motion (ms), zero under reduced motion.
    in-out property <bool> reduced-motion: false;
    out property <duration> fast: reduced-motion ? 0ms : 120ms;
    out property <duration> morph: reduced-motion ? 0ms : 240ms;
}

// Segoe MDL2 Assets code points.
export global Glyph {
    out property <string> settings: "\u{E713}";
    out property <string> close: "\u{E711}";
    out property <string> minimize: "\u{E921}";
    out property <string> maximize: "\u{E922}";
    out property <string> restore: "\u{E923}";
    out property <string> copy: "\u{E8C8}";
    out property <string> history: "\u{E81C}";
    out property <string> add: "\u{E710}";
    out property <string> mic: "\u{E720}";
    out property <string> info: "\u{E946}";
    out property <string> check: "\u{E73E}";
    out property <string> area: "\u{E7A8}";
    out property <string> refresh: "\u{E72C}";
    out property <string> stop: "\u{E71A}";
    out property <string> down: "\u{E70D}";
    out property <string> up: "\u{E70E}";
    out property <string> right: "\u{E76C}";
    out property <string> bubble: "\u{E8BD}";
    out property <string> pointer: "\u{E7C9}";
    out property <string> pin: "\u{E718}";
    out property <string> link: "\u{E71B}";
    out property <string> warning: "\u{E7BA}";
    out property <string> play: "\u{E768}";
    out property <string> pause: "\u{E769}";
    out property <string> search: "\u{E721}";
    out property <string> delete: "\u{E74D}";
    out property <string> more: "\u{E712}";
}

// A round, borderless icon button: a fill on hover, a ring on focus.
export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <string> tip;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <length> size: 32px;
    in property <length> glyph-size: 14px;
    in property <color> tint: active ? Theme.accent-text : Theme.label-2;
    callback clicked();
    callback pressed();
    out property <bool> hovered: touch.has-hover;

    width: size;
    height: size;
    border-radius: self.height / 2;
    background: !enabled ? transparent : touch.pressed ? Theme.fill-3 : touch.has-hover || active ? Theme.fill-2 : transparent;
    animate background { duration: Theme.fast; }

    Text {
        text: root.glyph;
        font-family: Theme.icons;
        font-size: root.glyph-size * Theme.text-scale;
        color: root.enabled ? root.tint : Theme.label-3;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.pressed();
            }
        }
    }
}

// A capsule with a label: the chips (a model, the target, an area).
export component Chip inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <string> trailing;
    in property <bool> prominent: false;
    callback clicked();
    callback trailing-clicked();

    height: 28px * Theme.text-scale;
    border-radius: self.height / 2;
    background: prominent ? Theme.accent-wash : chip-touch.has-hover ? Theme.fill-3 : Theme.fill-2;
    animate background { duration: Theme.fast; }

    chip-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: Theme.sp-3;
        padding-right: root.trailing != "" ? Theme.sp-1 : Theme.sp-3;
        spacing: Theme.sp-2;
        alignment: start;
        if root.glyph != "": Text {
            text: root.glyph;
            font-family: Theme.icons;
            font-size: 12px * Theme.text-scale;
            color: Theme.accent-text;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            font-size: Theme.caption;
            color: prominent ? Theme.accent-text : Theme.label;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.trailing != "": IconButton {
            glyph: root.trailing;
            size: 22px * Theme.text-scale;
            glyph-size: 10px;
            clicked => { root.trailing-clicked(); }
        }
    }
}

// A text button: plain, or prominent (the accent fill).
export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> prominent: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    min-width: label.preferred-width + 2 * Theme.sp-4;
    height: 32px * Theme.text-scale;
    border-radius: self.height / 2;
    background: !enabled ? Theme.fill-1 : prominent ? (btn-touch.pressed ? Theme.signal : Theme.accent) : btn-touch.pressed ? Theme.fill-3 : btn-touch.has-hover ? Theme.fill-3 : Theme.fill-2;
    animate background { duration: Theme.fast; }

    label := Text {
        text: root.text;
        font-size: Theme.row;
        font-weight: 600;
        color: !root.enabled ? Theme.label-3 : root.prominent ? Theme.on-accent : root.danger ? Theme.danger : Theme.label;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    btn-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One row of a menu: a label, optional key hints, a check when chosen.
export component MenuRow inherits Rectangle {
    in property <string> text;
    in property <string> keys;
    in property <bool> selected: false;
    in property <bool> checked: false;
    callback clicked();

    height: 36px * Theme.text-scale;
    border-radius: Theme.r-row;
    background: selected || row-touch.has-hover ? Theme.fill-2 : transparent;

    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: Theme.sp-3;
        padding-right: Theme.sp-3;
        spacing: Theme.sp-3;
        Text {
            text: root.text;
            font-size: Theme.row;
            color: Theme.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.keys != "": Text {
            text: root.keys;
            font-size: Theme.meta;
            color: Theme.label-3;
            vertical-alignment: center;
        }
        Text {
            text: root.checked ? Glyph.check : "";
            font-family: Theme.icons;
            font-size: 12px * Theme.text-scale;
            color: Theme.accent-text;
            vertical-alignment: center;
            width: 14px * Theme.text-scale;
        }
    }
}
