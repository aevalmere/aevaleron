// History (history/history.html), native (lane native-ui). The search, the
// list (one group per day; a row is the question, the opening of the
// answer and when), the footer with Undo and Delete all, and the row menu.
// The list is a ListView: only the rows in view exist, so thousands of
// conversations scroll as cheaply as ten. src/ui/history.rs drives it.

import { ListView } from "std-widgets.slint";
import { Theme, Glyph, IconButton, Button, MenuRow } from "theme.slint";
import { TextField, TextButton } from "settings-widgets.slint";

// A day's heading, or a conversation.
export struct HistRow {
    header: bool,
    id: string,
    title: string,
    reply: string,
    meta: string,
}

export component HistoryWindow inherits Window {
    background: Theme.base;
    default-font-family: Theme.font;
    default-font-size: Theme.row;
    min-width: 360px;
    min-height: 300px;

    in property <[HistRow]> rows;
    // The row the keyboard is on, -1 for the search.
    in property <int> mark: -1;
    in property <bool> list-shown: true;
    in property <string> empty-text;
    in property <bool> empty-turn-on;
    in property <bool> off-note;
    in property <string> count-text;
    in property <string> note-text;
    in property <bool> undo-shown;
    in property <bool> clear-shown;
    in property <string> confirm-text;
    in property <bool> menu-open;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <int> menu-mark: 0;
    out property <string> query: search.text;
    out property <length> list-height: lv.visible-height;

    callback drag();
    callback maximize();
    callback close-clicked();
    callback search-edited(string);
    callback search-accepted();
    callback open-row(string);
    callback delete-row(string);
    callback menu-at(string, length, length);
    callback menu-pick(string);
    callback menu-dismiss();
    callback undo();
    callback clear-all();
    callback confirm(bool);
    callback turn-on();

    public function focus-search() {
        search.focus-field();
    }

    public function set-search(t: string) {
        search.set-text(t);
    }

    // Keeps a row (its top `y` and height `h` in the list) in view.
    public function show-row(y: length, h: length) {
        if (y < -lv.content-y) {
            lv.content-y = -y;
        } else if (y + h > -lv.content-y + lv.visible-height) {
            lv.content-y = -(y + h - lv.visible-height);
        }
    }

    VerticalLayout {
        // The title area: drag to move, double-click to maximize.
        Rectangle {
            height: 48px;
            TouchArea {
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                        root.drag();
                    }
                }
                double-clicked => {
                    root.maximize();
                }
            }
            HorizontalLayout {
                padding-left: Theme.sp-5;
                padding-right: Theme.sp-3;
                Text {
                    text: "History";
                    font-size: Theme.title;
                    font-weight: 600;
                    color: Theme.label;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        glyph: Glyph.close;
                        tip: "Close history";
                        size: 28px;
                        glyph-size: 11px;
                        clicked => {
                            root.close-clicked();
                        }
                    }
                }
            }
        }

        // The search.
        HorizontalLayout {
            padding-left: Theme.sp-4;
            padding-right: Theme.sp-4;
            padding-bottom: Theme.sp-2;
            spacing: Theme.sp-2;
            Rectangle {
                horizontal-stretch: 1;
                height: 40px * Theme.text-scale;
                border-radius: self.height / 2;
                background: Theme.fill-1;
                HorizontalLayout {
                    padding-left: Theme.sp-3;
                    padding-right: Theme.sp-1;
                    spacing: Theme.sp-2;
                    Text {
                        text: Glyph.search;
                        font-family: Theme.icons;
                        font-size: 13px * Theme.text-scale;
                        color: Theme.label-3;
                        vertical-alignment: center;
                    }
                    search := TextField {
                        placeholder: "Search your conversations";
                        background: transparent;
                        edited(t) => {
                            root.search-edited(t);
                        }
                        accepted(t) => {
                            root.search-accepted();
                        }
                    }
                    if search.text != "": VerticalLayout {
                        alignment: center;
                        IconButton {
                            glyph: Glyph.close;
                            tip: "Clear the search";
                            size: 28px;
                            glyph-size: 10px;
                            clicked => {
                                search.set-text("");
                                root.search-edited("");
                                search.focus-field();
                            }
                        }
                    }
                }
            }
        }

        // History is off, but older conversations are still here.
        if root.off-note: HorizontalLayout {
            padding-left: Theme.sp-5;
            padding-right: Theme.sp-5;
            spacing: Theme.sp-2;
            Text {
                text: "History is off, so nothing new is being saved.";
                font-size: Theme.caption;
                color: Theme.label-2;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
            TextButton {
                text: "Turn on";
                clicked => {
                    root.turn-on();
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            lv := ListView {
                visible: root.list-shown;
                for r[i] in root.rows: Rectangle {
                    height: r.header ? 36px * Theme.text-scale : 68px * Theme.text-scale;
                    if r.header: Text {
                        x: Theme.sp-5;
                        y: 0;
                        width: parent.width - 2 * Theme.sp-5;
                        height: parent.height - Theme.sp-1;
                        text: r.title;
                        font-size: Theme.caption;
                        font-weight: 600;
                        color: Theme.label-3;
                        vertical-alignment: bottom;
                    }
                    if !r.header: Rectangle {
                        x: Theme.sp-3;
                        y: 2px;
                        width: parent.width - 2 * Theme.sp-3;
                        height: parent.height - 4px;
                        border-radius: Theme.r-plate;
                        background: i == root.mark ? Theme.fill-2 : row-touch.has-hover ? Theme.fill-1 : transparent;
                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open-row(r.id);
                            }
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                    root.menu-at(r.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: Theme.sp-3;
                            padding-right: Theme.sp-1;
                            spacing: Theme.sp-2;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: r.title;
                                    font-size: Theme.row;
                                    font-weight: 600;
                                    color: Theme.label;
                                    overflow: elide;
                                }
                                if r.reply != "": Text {
                                    text: r.reply;
                                    font-size: Theme.caption;
                                    color: Theme.label-2;
                                    overflow: elide;
                                }
                                Text {
                                    text: r.meta;
                                    font-size: Theme.meta;
                                    color: Theme.label-3;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    glyph: Glyph.delete;
                                    tip: "Delete";
                                    size: 30px;
                                    glyph-size: 12px;
                                    clicked => {
                                        root.delete-row(r.id);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if !root.list-shown: VerticalLayout {
                alignment: center;
                padding-left: Theme.sp-6;
                padding-right: Theme.sp-6;
                spacing: Theme.sp-2;
                Text {
                    text: root.empty-text;
                    font-size: Theme.row;
                    color: Theme.label-2;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.empty-turn-on: HorizontalLayout {
                    alignment: center;
                    TextButton {
                        text: "Turn on";
                        clicked => {
                            root.turn-on();
                        }
                    }
                }
            }
        }

        // The footer: the count, a note with Undo, Delete all, or the
        // confirmation in its place.
        HorizontalLayout {
            min-height: 48px;
            padding-left: Theme.sp-5;
            padding-right: Theme.sp-3;
            spacing: Theme.sp-2;
            if root.confirm-text == "" && root.note-text == "" && root.count-text != "": Text {
                text: root.count-text;
                font-size: Theme.caption;
                color: Theme.label-3;
                vertical-alignment: center;
            }
            if root.confirm-text == "" && root.note-text != "": Text {
                text: root.note-text;
                font-size: Theme.caption;
                color: Theme.label-2;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if root.confirm-text == "" && root.undo-shown: VerticalLayout {
                alignment: center;
                TextButton {
                    text: "Undo";
                    clicked => {
                        root.undo();
                    }
                }
            }
            if root.confirm-text != "": Text {
                text: root.confirm-text;
                font-size: Theme.row;
                color: Theme.label;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.confirm-text != "": VerticalLayout {
                alignment: center;
                Button {
                    text: "Delete";
                    danger: true;
                    clicked => {
                        root.confirm(true);
                    }
                }
            }
            if root.confirm-text != "": VerticalLayout {
                alignment: center;
                Button {
                    text: "Keep";
                    clicked => {
                        root.confirm(false);
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            if root.confirm-text == "" && root.clear-shown: VerticalLayout {
                alignment: center;
                TextButton {
                    text: "Delete all";
                    danger: true;
                    clicked => {
                        root.clear-all();
                    }
                }
            }
        }
    }

    // The row menu, at the pointer, kept inside the window; a press
    // anywhere else puts it away.
    if root.menu-open: TouchArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        clicked => {
            root.menu-dismiss();
        }
    }
    if root.menu-open: Rectangle {
        width: 200px * Theme.text-scale;
        height: menu-col.preferred-height;
        x: max(4px, min(root.menu-x, root.width - self.width - 4px));
        y: max(4px, min(root.menu-y, root.height - self.height - 4px));
        border-radius: Theme.r-card;
        background: Theme.raised;
        drop-shadow-blur: 16px;
        drop-shadow-color: #5A3A3A2B;
        drop-shadow-offset-y: 4px;
        menu-col := VerticalLayout {
            padding: Theme.sp-1;
            MenuRow {
                text: "Ask again";
                selected: root.menu-mark == 0;
                clicked => {
                    root.menu-pick("ask");
                }
            }
            MenuRow {
                text: "Copy question";
                selected: root.menu-mark == 1;
                clicked => {
                    root.menu-pick("copy");
                }
            }
            MenuRow {
                text: "Delete";
                selected: root.menu-mark == 2;
                clicked => {
                    root.menu-pick("delete");
                }
            }
        }
    }
}
