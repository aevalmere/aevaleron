// Settings' Providers and Models pages (settings.html #pg-providers,
// #pg-models). A provider row is its head (place, name, key hint, state)
// and, while open, what its state offers: a message, the key field, the
// actions and the order buttons. Press a head and move it to reorder.

import { Theme, Glyph, Button } from "theme.slint";
import { SettingsState, SetProvRow, SetCliRow, SetRoleRow } from "settings-state.slint";
import { PageTitle, Group, Note, Switch, SwitchRow, ChoiceOption, Segments, TextField, TextButton, Disclosure, Combo } from "settings-widgets.slint";

component ProvRowView inherits Rectangle {
    in property <SetProvRow> it;
    in property <int> index;
    in property <int> count;
    property <bool> open: SettingsState.open-row == "prov-" + root.it.id;
    property <int> epoch: root.it.epoch;
    property <int> focus-at: root.it.focus;
    property <bool> shown: false;
    property <length> pressed-y;
    property <length> head-h: 56px * Theme.text-scale;
    property <bool> dragged: SettingsState.drag-id == root.it.id;
    property <bool> lands-here: SettingsState.drag-id != "" && !root.dragged && SettingsState.drag-to == root.index;

    changed epoch => {
        field.set-text(root.it.field-text);
        root.shown = false;
    }
    changed focus-at => {
        field.focus-field();
    }

    border-radius: Theme.r-row;
    background: root.dragged ? Theme.accent-wash : transparent;

    // Where a dragged row would land: a line at the top of this one.
    Rectangle {
        visible: root.lands-here;
        x: Theme.sp-3;
        y: 0;
        width: parent.width - 2 * Theme.sp-3;
        height: 2px;
        background: Theme.accent;
    }

    VerticalLayout {
        Rectangle {
            min-height: root.head-h;
            border-radius: Theme.r-row;
            background: head-touch.has-hover ? Theme.fill-1 : transparent;
            head-touch := TouchArea {
                mouse-cursor: SettingsState.ordered ? MouseCursor.grab : MouseCursor.pointer;
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                        root.pressed-y = self.mouse-y;
                    }
                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                        if (SettingsState.drag-id == root.it.id) {
                            SettingsState.prov-move(root.it.id, SettingsState.drag-to);
                        } else {
                            SettingsState.combo-open = "";
                            SettingsState.open-row = root.open ? "" : "prov-" + root.it.id;
                        }
                    }
                }
                moved => {
                    if (self.pressed && SettingsState.ordered && root.count > 1) {
                        if (SettingsState.drag-id == root.it.id || abs(self.mouse-y - root.pressed-y) > 6px) {
                            SettingsState.drag-id = root.it.id;
                            SettingsState.drag-to = max(0, min(root.count - 1, root.index + round((self.mouse-y - root.pressed-y) / root.head-h)));
                        }
                    }
                }
            }
            HorizontalLayout {
                padding-left: Theme.sp-2;
                padding-right: Theme.sp-3;
                spacing: Theme.sp-3;
                if SettingsState.ordered: Text {
                    text: "\u{E700}";
                    font-family: Theme.icons;
                    font-size: 12px * Theme.text-scale;
                    color: Theme.label-3;
                    vertical-alignment: center;
                }
                Text {
                    text: root.it.pos;
                    font-size: Theme.caption;
                    color: Theme.label-3;
                    vertical-alignment: center;
                    min-width: 12px;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: root.it.name;
                        font-size: Theme.row;
                        font-weight: 600;
                        color: Theme.label;
                        overflow: elide;
                    }
                    Text {
                        text: root.it.sub;
                        font-size: Theme.meta;
                        font-family: root.it.mono ? Theme.mono : Theme.font;
                        color: Theme.label-3;
                        overflow: elide;
                    }
                }
                HorizontalLayout {
                    spacing: Theme.sp-1;
                    alignment: end;
                    Text {
                        text: root.it.icon;
                        font-family: Theme.icons;
                        font-size: 12px * Theme.text-scale;
                        color: root.it.tone == "danger" ? Theme.danger : root.it.tone == "ok" ? Theme.accent-text : Theme.label-2;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.it.word;
                        font-size: Theme.caption;
                        color: root.it.tone == "danger" ? Theme.danger : root.it.tone == "ok" ? Theme.accent-text : Theme.label-2;
                        vertical-alignment: center;
                    }
                }
                if root.it.is-default: Rectangle {
                    height: 22px * Theme.text-scale;
                    min-width: cap.preferred-width + 2 * Theme.sp-2;
                    border-radius: self.height / 2;
                    background: Theme.accent-wash;
                    cap := Text {
                        text: "Default";
                        font-size: Theme.meta;
                        color: Theme.accent-text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.open ? Glyph.up : Glyph.down;
                    font-family: Theme.icons;
                    font-size: 10px * Theme.text-scale;
                    color: Theme.label-3;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            clip: true;
            height: root.open ? body.preferred-height : 0px;
            body := VerticalLayout {
                padding-left: Theme.sp-3;
                padding-right: Theme.sp-3;
                padding-bottom: Theme.sp-4;
                spacing: Theme.sp-3;

                if root.it.msg != "": Note {
                    text: root.it.msg;
                    tone: root.it.msg-danger ? "danger" : "";
                    font-size: Theme.row;
                    color: root.it.msg-danger ? Theme.danger : Theme.label-2;
                }

                if root.it.clip != "": HorizontalLayout {
                    spacing: Theme.sp-3;
                    Text {
                        text: "Key on the clipboard: " + root.it.clip;
                        font-size: Theme.caption;
                        font-family: Theme.mono;
                        color: Theme.label-2;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Button {
                        text: "Use this key";
                        prominent: true;
                        clicked => {
                            SettingsState.prov-act(root.it.id, "clip", "");
                        }
                    }
                }

                // The field lives as long as the row: a re-render never
                // moves it, so a half-pasted key survives.
                Rectangle {
                    height: root.it.field ? field-col.preferred-height : 0px;
                    clip: true;
                    field-col := VerticalLayout {
                        spacing: Theme.sp-1;
                        Text {
                            text: root.it.field-label;
                            font-size: Theme.caption;
                            color: Theme.label-2;
                        }
                        HorizontalLayout {
                            spacing: Theme.sp-2;
                            field := TextField {
                                placeholder: root.it.placeholder;
                                password: !root.shown;
                                mono: true;
                                enabled: !root.it.busy;
                                edited(t) => {
                                    SettingsState.prov-edited(root.it.id, t);
                                }
                                accepted(t) => {
                                    SettingsState.prov-act(root.it.id, "enter", t);
                                }
                            }
                            Button {
                                text: root.shown ? "Hide" : "Show";
                                enabled: !root.it.busy;
                                clicked => {
                                    root.shown = !root.shown;
                                    field.focus-field();
                                }
                            }
                            Button {
                                text: "Save";
                                prominent: root.it.save-prominent;
                                enabled: !root.it.busy;
                                clicked => {
                                    SettingsState.prov-act(root.it.id, "save", field.text);
                                }
                            }
                        }
                    }
                }

                if root.it.actions.length > 0: HorizontalLayout {
                    spacing: Theme.sp-2;
                    alignment: start;
                    for a in root.it.actions: HorizontalLayout {
                        if a.kind == "text": TextButton {
                            text: a.label;
                            enabled: !a.disabled;
                            clicked => {
                                SettingsState.prov-act(root.it.id, a.id, field.text);
                            }
                        }
                        if a.kind == "link": TextButton {
                            text: a.label;
                            clicked => {
                                SettingsState.act("open-url", a.href);
                            }
                        }
                        if a.kind == "link-button": Button {
                            text: a.label;
                            clicked => {
                                SettingsState.act("open-url", a.href);
                            }
                        }
                        if a.kind != "text" && a.kind != "link" && a.kind != "link-button": Button {
                            text: a.label;
                            prominent: a.kind == "prominent";
                            danger: a.kind == "danger";
                            enabled: !a.disabled;
                            clicked => {
                                SettingsState.prov-act(root.it.id, a.id, field.text);
                            }
                        }
                    }
                }

                if root.it.order: HorizontalLayout {
                    spacing: Theme.sp-1;
                    alignment: start;
                    TextButton {
                        text: "Move up";
                        enabled: root.it.can-up;
                        clicked => {
                            SettingsState.prov-act(root.it.id, "up", "");
                        }
                    }
                    TextButton {
                        text: "Move down";
                        enabled: root.it.can-down;
                        clicked => {
                            SettingsState.prov-act(root.it.id, "down", "");
                        }
                    }
                    if root.it.show-first: TextButton {
                        text: "Use first";
                        enabled: !root.it.busy;
                        clicked => {
                            SettingsState.prov-act(root.it.id, "first", "");
                        }
                    }
                }
            }
        }
    }
}

// A command-line tool: its head (name, what was found, the switch) and,
// while open, the program, Test, Use first and the path field. A tool
// that is not installed says how to get it and keeps only the path field.
component CliRowView inherits Rectangle {
    in property <SetCliRow> it;
    property <bool> open: SettingsState.open-row == "prov-" + root.it.id;
    property <int> epoch: root.it.epoch;

    changed epoch => {
        path-field.set-text(root.it.field-text);
    }
    init => {
        path-field.set-text(root.it.field-text);
    }

    border-radius: Theme.r-row;

    VerticalLayout {
        Rectangle {
            min-height: 56px * Theme.text-scale;
            border-radius: Theme.r-row;
            background: head-touch.has-hover ? Theme.fill-1 : transparent;
            head-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    SettingsState.combo-open = "";
                    SettingsState.role-open = "";
                    SettingsState.open-row = root.open ? "" : "prov-" + root.it.id;
                }
            }
            HorizontalLayout {
                padding-left: Theme.sp-3;
                padding-right: Theme.sp-3;
                spacing: Theme.sp-3;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: root.it.name;
                        font-size: Theme.row;
                        font-weight: 600;
                        color: Theme.label;
                        overflow: elide;
                    }
                    Text {
                        text: root.it.status;
                        font-size: Theme.meta;
                        color: root.it.status-danger ? Theme.danger : Theme.label-3;
                        overflow: elide;
                    }
                }
                if root.it.installed: VerticalLayout {
                    alignment: center;
                    Switch {
                        checked: root.it.enabled;
                        enabled: !root.it.busy;
                        toggled(v) => {
                            SettingsState.cli-toggle(root.it.id, v);
                        }
                    }
                }
                Text {
                    text: root.open ? Glyph.up : Glyph.down;
                    font-family: Theme.icons;
                    font-size: 10px * Theme.text-scale;
                    color: Theme.label-3;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            clip: true;
            height: root.open ? body.preferred-height : 0px;
            body := VerticalLayout {
                padding-left: Theme.sp-3;
                padding-right: Theme.sp-3;
                padding-bottom: Theme.sp-4;
                spacing: Theme.sp-3;

                if root.it.how != "": Note {
                    text: root.it.how;
                    font-size: Theme.row;
                    color: Theme.label-2;
                }

                if root.it.path != "": Text {
                    text: root.it.path;
                    font-size: Theme.caption;
                    font-family: Theme.mono;
                    color: Theme.label-2;
                    overflow: elide;
                }

                if root.it.msg != "": Note {
                    text: root.it.msg;
                    tone: root.it.msg-danger ? "danger" : "";
                    font-size: Theme.row;
                    color: root.it.msg-danger ? Theme.danger : Theme.label-2;
                }

                if root.it.installed: HorizontalLayout {
                    spacing: Theme.sp-2;
                    alignment: start;
                    Button {
                        text: root.it.testing ? "Testing…" : "Test";
                        enabled: !root.it.busy;
                        clicked => {
                            SettingsState.cli-act(root.it.id, "test", "");
                        }
                    }
                    if root.it.show-first: TextButton {
                        text: "Use first";
                        enabled: !root.it.busy;
                        clicked => {
                            SettingsState.cli-act(root.it.id, "first", "");
                        }
                    }
                }

                // The field lives as long as the row, so a re-render never
                // takes what is being typed.
                VerticalLayout {
                    spacing: Theme.sp-1;
                    Text {
                        text: "Program path";
                        font-size: Theme.caption;
                        color: Theme.label-2;
                    }
                    HorizontalLayout {
                        spacing: Theme.sp-2;
                        path-field := TextField {
                            placeholder: "Found on its own when empty";
                            mono: true;
                            enabled: !root.it.busy;
                            accepted(t) => {
                                SettingsState.cli-act(root.it.id, "path", t);
                            }
                        }
                        Button {
                            text: "Save";
                            enabled: !root.it.busy;
                            clicked => {
                                SettingsState.cli-act(root.it.id, "path", path-field.text);
                            }
                        }
                    }
                }
            }
        }
    }
}

// One job and the provider it tries first: a picker that opens in place.
component RolePick inherits Rectangle {
    in property <SetRoleRow> it;
    property <bool> open: SettingsState.role-open == root.it.role;
    border-radius: Theme.r-row;

    VerticalLayout {
        padding-left: Theme.sp-3;
        padding-right: Theme.sp-3;
        padding-top: Theme.sp-2;
        padding-bottom: Theme.sp-2;
        spacing: Theme.sp-1;
        HorizontalLayout {
            spacing: Theme.sp-3;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: root.it.title;
                    font-size: Theme.row;
                    color: Theme.label;
                    wrap: word-wrap;
                }
                if root.it.note != "": Text {
                    text: root.it.note;
                    font-size: Theme.meta;
                    color: Theme.label-3;
                    wrap: word-wrap;
                }
            }
            Rectangle {
                min-width: 200px * Theme.text-scale;
                min-height: 40px * Theme.text-scale;
                border-radius: Theme.r-plate;
                background: face-touch.has-hover || root.open ? Theme.fill-2 : Theme.fill-1;
                face-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        SettingsState.combo-open = "";
                        SettingsState.role-open = root.open ? "" : root.it.role;
                    }
                }
                HorizontalLayout {
                    padding-left: Theme.sp-3;
                    padding-right: Theme.sp-3;
                    spacing: Theme.sp-2;
                    Text {
                        text: root.it.label;
                        font-size: Theme.row;
                        color: Theme.label;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: root.open ? Glyph.up : Glyph.down;
                        font-family: Theme.icons;
                        font-size: 10px * Theme.text-scale;
                        color: Theme.label-3;
                        vertical-alignment: center;
                    }
                }
            }
        }
        if root.open: Rectangle {
            background: Theme.raised;
            border-radius: Theme.r-card;
            VerticalLayout {
                padding: Theme.sp-1;
                for r in root.it.rows: Rectangle {
                    min-height: 40px * Theme.text-scale;
                    border-radius: Theme.r-row;
                    background: opt-touch.has-hover ? Theme.fill-2 : transparent;
                    opt-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            SettingsState.role-open = "";
                            SettingsState.role-pick(root.it.role, r.id);
                        }
                    }
                    HorizontalLayout {
                        padding-left: Theme.sp-3;
                        padding-right: Theme.sp-3;
                        padding-top: Theme.sp-1;
                        padding-bottom: Theme.sp-1;
                        spacing: Theme.sp-2;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: r.name;
                                font-size: Theme.row;
                                color: Theme.label;
                                overflow: elide;
                            }
                            if r.detail != "": Text {
                                text: r.detail;
                                font-size: Theme.meta;
                                color: Theme.label-3;
                                overflow: elide;
                            }
                        }
                        Text {
                            text: r.checked ? Glyph.check : "";
                            font-family: Theme.icons;
                            font-size: 12px * Theme.text-scale;
                            color: Theme.accent-text;
                            vertical-alignment: center;
                            width: 14px * Theme.text-scale;
                        }
                    }
                }
            }
        }
    }
}

// The command-line tools (Claude Code, Codex, Gemini CLI) and the
// provider each job tries first.
component CliPicker inherits VerticalLayout {
    spacing: Theme.sp-3;
    HorizontalLayout {
        padding-top: Theme.sp-3;
        spacing: Theme.sp-3;
        Text {
            text: "Command-line tools";
            font-size: Theme.title;
            font-weight: 600;
            color: Theme.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        TextButton {
            text: SettingsState.cli-checking ? "Checking…" : "Check again";
            enabled: !SettingsState.cli-checking;
            clicked => {
                SettingsState.cli-act("", "check", "");
            }
        }
    }
    Note {
        text: "These answer through the program on this PC, signed in with your own account. No key needed.";
        font-size: Theme.row;
        color: Theme.label-2;
    }
    if SettingsState.clis.length > 0: Group {
        for c in SettingsState.clis: CliRowView {
            it: c;
        }
    }
    if SettingsState.clis.length == 0: Note {
        text: SettingsState.cli-checking ? "Looking for them…" : "None found.";
    }
    Text {
        text: "Provider for each job";
        font-size: Theme.title;
        font-weight: 600;
        color: Theme.label;
    }
    Note {
        text: "Automatic follows the order above. A job with its own pick tries that provider first.";
        font-size: Theme.row;
        color: Theme.label-2;
    }
    Group {
        for r in SettingsState.roles: RolePick {
            it: r;
        }
    }
}

export component ProvidersPage inherits VerticalLayout {
    spacing: Theme.sp-3;
    PageTitle {
        text: "Providers";
        lede: SettingsState.ordered ? "Answers come from the first ready provider in this list. Drag to change the order." : "Answers come from the first ready provider in this list.";
    }
    Group {
        for p[i] in SettingsState.providers: ProvRowView {
            it: p;
            index: i;
            count: SettingsState.providers.length;
        }
    }
    if SettingsState.cli-picker-shown: CliPicker { }
    if SettingsState.prov-live != "": Note {
        text: SettingsState.prov-live;
        font-size: Theme.row;
        color: Theme.label-2;
    }
    if SettingsState.failover-shown: Group {
        SwitchRow {
            text: "When one is busy or fails, try the next";
            checked: SettingsState.failover-across;
            toggled(v) => {
                SettingsState.toggle("failover-across", v);
            }
        }
        SwitchRow {
            text: "Ask me before switching from free models to a paid provider";
            indent: Theme.sp-4;
            checked: SettingsState.failover-ask;
            enabled: SettingsState.failover-across;
            toggled(v) => {
                SettingsState.toggle("failover-ask", v);
            }
        }
    }
    if SettingsState.key-storage != "": Note {
        text: SettingsState.key-storage;
        tone: SettingsState.key-storage-warn ? "warn" : "";
    }
}

export component ModelsPage inherits VerticalLayout {
    spacing: Theme.sp-3;
    PageTitle {
        text: "Models";
    }
    Group {
        ChoiceOption {
            name: "Automatic (recommended)";
            note: "Aevaleron picks a model for each job: free ones on OpenRouter, the recommended one elsewhere.";
            checked: SettingsState.models-mode == "auto";
            clicked => {
                SettingsState.act("models-mode", "auto");
            }
        }
        ChoiceOption {
            name: "Choose for each job";
            checked: SettingsState.models-mode == "custom";
            clicked => {
                SettingsState.act("models-mode", "custom");
            }
        }
    }
    if SettingsState.models-mode == "custom": VerticalLayout {
        spacing: Theme.sp-3;
        if SettingsState.models-for.length > 0: HorizontalLayout {
            spacing: Theme.sp-3;
            Text {
                text: "Models for";
                font-size: Theme.row;
                color: Theme.label-2;
                vertical-alignment: center;
            }
            Segments {
                group: "models-for";
                choices: SettingsState.models-for;
            }
        }
        Group {
            Disclosure {
                rid: "sec-model";
                title: "Screen model";
                summary: SettingsState.model-summary;
                Note {
                    text: "Looks at your screen and answers.";
                }
                Combo {
                    cid: "model";
                    view: SettingsState.model-combo;
                }
            }
            Disclosure {
                rid: "sec-brain";
                title: "Answer model";
                summary: SettingsState.brain-summary;
                SwitchRow {
                    text: "Let the screen model read, and a bigger model answer";
                    checked: SettingsState.brain-enabled;
                    toggled(v) => {
                        SettingsState.toggle("brain-enabled", v);
                    }
                }
                if SettingsState.brain-enabled: Combo {
                    cid: "brain";
                    view: SettingsState.brain-combo;
                }
            }
            Disclosure {
                rid: "sec-agent-model";
                title: "Task model";
                summary: SettingsState.agent-model-summary;
                Note {
                    text: "Any model works. Tools means it calls actions natively; JSON mode means it writes them out, which works but slips more often.";
                }
                Combo {
                    cid: "agent";
                    view: SettingsState.agent-combo;
                }
            }
        }
    }
    Group {
        if SettingsState.paid-shown: SwitchRow {
            text: "Show paid models";
            checked: SettingsState.show-paid;
            toggled(v) => {
                SettingsState.toggle("show-paid", v);
            }
        }
        if !SettingsState.paid-shown: Note {
            text: "Every model here is billed per question.";
            font-size: Theme.row;
        }
    }
}
