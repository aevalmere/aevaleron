// An answer window (renderer/output.html, output.js, trail.js): a title bar
// it is held by, and the transcript, drawn from one flat list of rows that
// Rust builds (src/ui/output.rs). The window is opaque: it is the sheet, and
// its height follows `content-height` until the person sizes it.

import { Theme, Glyph, IconButton, MenuRow } from "theme.slint";

// One button in a row. `id` says what it does; Rust reads it back.
export struct OutButton {
    id: string,
    text: string,
    glyph: string,
    prominent: bool,
    enabled: bool,
    checked: bool,
    focused: bool,
}

// One drawn row of the transcript. `kind` picks the element; the other
// fields mean what that kind needs (output.rs documents each).
export struct OutRow {
    key: string,
    kind: string,
    text: string,
    sub: string,
    extra: string,
    note: string,
    value: string,
    state: string,
    marker: string,
    level: int,
    strong: bool,
    mono: bool,
    accent: bool,
    gap: length,
    lines: [string],
    cells: [string],
    aligns: [string],
    buttons: [OutButton],
    picture: image,
}

export struct OutMenuRow {
    header: bool,
    text: string,
    note: string,
    checked: bool,
}

// Selectable, never editable: the answer's words.
component Words inherits TextInput {
    read-only: true;
    single-line: false;
    wrap: word-wrap;
    font-size: Theme.body-size;
    color: Theme.label;
    selection-background-color: Theme.selection;
    selection-foreground-color: Theme.label;
}

// The one button shape in a sheet: a 32 px capsule, 13 px semibold.
component RowButton inherits Rectangle {
    in property <OutButton> b;
    // Where it is in the window, for a menu that opens under it.
    callback activated(length, length, length);
    property <bool> icon-only: root.b.text == "";

    height: 32px * Theme.text-scale;
    width: root.icon-only ? self.height : inner.preferred-width;
    border-radius: self.height / 2;
    border-width: root.b.focused ? 2px : 0px;
    border-color: Theme.focus-ring;
    background: !root.b.enabled ? Theme.fill-1
        : root.b.prominent ? (touch.pressed ? Theme.signal : Theme.accent)
        : touch.pressed ? Theme.fill-3
        : touch.has-hover || root.b.checked ? Theme.fill-3 : Theme.fill-2;
    animate background { duration: Theme.fast; }

    inner := HorizontalLayout {
        padding-left: root.icon-only ? 0px : Theme.sp-4;
        padding-right: root.icon-only ? 0px : Theme.sp-4;
        spacing: Theme.sp-2;
        alignment: center;
        if root.b.glyph != "": Text {
            text: root.b.glyph;
            font-family: Theme.icons;
            font-size: 12px * Theme.text-scale;
            color: !root.b.enabled ? Theme.label-3 : root.b.prominent ? Theme.on-accent : Theme.label;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.b.text != "": Text {
            text: root.b.text;
            font-size: Theme.caption;
            font-weight: 600;
            color: !root.b.enabled ? Theme.label-3 : root.b.prominent ? Theme.on-accent : Theme.label;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.b.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated(root.absolute-position.x, root.absolute-position.y, root.absolute-position.y + root.height);
        }
    }
}

// Three dots that breathe while something is still coming; still under
// reduced motion.
component Dots inherits Rectangle {
    width: 26px * Theme.text-scale;
    height: 20px * Theme.text-scale;
    for i in 3: Rectangle {
        x: i * 10px * Theme.text-scale;
        y: (parent.height - self.height) / 2;
        width: 6px * Theme.text-scale;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.accent;
        opacity: Theme.reduced-motion ? 1 - i * 0.3 : 0.35 + 0.65 * abs(sin((animation-tick() / 1ms) * 0.3deg - i * 40deg));
    }
}

// A row of buttons, as the row's key and each button's id.
component Buttons inherits Rectangle {
    in property <[OutButton]> list;
    in property <string> key;
    callback button(string, string, length, length, length);

    HorizontalLayout {
        spacing: Theme.sp-2;
        for b in root.list: RowButton {
            b: b;
            activated(x, top, bottom) => {
                root.button(root.key, b.id, x, top, bottom);
            }
        }
    }
}

component RowView inherits Rectangle {
    in property <OutRow> it;
    callback button(string, string, length, length, length);
    callback context(string);

    property <length> indent: root.it.level * 22px * Theme.text-scale;
    property <bool> head: root.it.state == "head";
    property <color> mark-color: root.it.state == "failed" ? Theme.danger
        : root.it.state == "done" ? Theme.accent-text
        : root.it.state == "running" || root.it.state == "paused" ? Theme.accent
        : Theme.label-3;

    // A right press anywhere the words do not take it: the row's menu.
    TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.context(root.it.key);
            }
        }
    }

    VerticalLayout {
        padding-top: root.it.gap;

        // A question after the first (the first is the title).
        if root.it.kind == "user": HorizontalLayout {
            alignment: start;
            Rectangle {
                background: Theme.fill-2;
                border-radius: Theme.r-card;
                HorizontalLayout {
                    padding-left: Theme.sp-4;
                    padding-right: Theme.sp-4;
                    padding-top: Theme.sp-2;
                    padding-bottom: Theme.sp-2;
                    Text {
                        text: root.it.text;
                        wrap: word-wrap;
                        font-size: Theme.row;
                        color: Theme.label-2;
                    }
                }
            }
        }

        if root.it.kind == "h": Words {
            text: root.it.text;
            font-size: root.it.level >= 3 ? Theme.body-size : Theme.title;
            font-weight: 600;
        }

        if root.it.kind == "p": HorizontalLayout {
            padding-left: root.indent;
            Words {
                text: root.it.text;
                font-weight: root.it.strong ? 600 : 400;
                font-family: root.it.mono ? Theme.mono : Theme.font;
                font-size: root.it.mono ? Theme.code : Theme.body-size;
                color: root.it.accent ? Theme.label-2 : Theme.label;
            }
        }

        if root.it.kind == "li": HorizontalLayout {
            padding-left: root.indent;
            spacing: Theme.sp-2;
            Text {
                text: root.it.marker;
                width: 22px * Theme.text-scale;
                font-size: Theme.body-size;
                color: Theme.label-2;
                horizontal-alignment: right;
                vertical-alignment: top;
            }
            Words {
                horizontal-stretch: 1;
                text: root.it.text;
                font-weight: root.it.strong ? 600 : 400;
                font-family: root.it.mono ? Theme.mono : Theme.font;
                font-size: root.it.mono ? Theme.code : Theme.body-size;
            }
        }

        if root.it.kind == "quote": HorizontalLayout {
            padding-left: root.indent;
            spacing: Theme.sp-3;
            Rectangle {
                width: 3px;
                border-radius: 1.5px;
                background: Theme.fill-3;
            }
            Words {
                horizontal-stretch: 1;
                text: root.it.text;
                color: Theme.label-2;
            }
        }

        if root.it.kind == "hr": Rectangle {
            height: 1px;
            background: Theme.hairline;
        }

        // A fenced block: Cascadia Mono on a plate, its language and Copy.
        if root.it.kind == "code": HorizontalLayout {
            padding-left: root.indent;
            Rectangle {
                background: Theme.plate;
                border-radius: Theme.r-plate;
                VerticalLayout {
                    padding: Theme.sp-3;
                    spacing: Theme.sp-1;
                    HorizontalLayout {
                        spacing: Theme.sp-2;
                        Text {
                            text: root.it.sub;
                            font-size: Theme.meta;
                            color: Theme.label-3;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Buttons {
                            list: root.it.buttons;
                            key: root.it.key;
                            button(k, id, x, t, b) => {
                                root.button(k, id, x, t, b);
                            }
                        }
                    }
                    Words {
                        text: root.it.text;
                        font-family: Theme.mono;
                        font-size: Theme.code;
                    }
                }
            }
        }

        // One table row; every row has the same columns at the same width.
        if root.it.kind == "table": HorizontalLayout {
            padding-left: root.indent;
            spacing: Theme.sp-3;
            for c[i] in root.it.cells: Text {
                text: c;
                wrap: word-wrap;
                min-width: 1px;
                preferred-width: 1px;
                horizontal-stretch: 1;
                font-size: Theme.row;
                font-weight: root.head ? 600 : 400;
                color: root.head ? Theme.label : Theme.label-2;
                horizontal-alignment: root.it.aligns[i] == "right" ? TextHorizontalAlignment.right
                    : root.it.aligns[i] == "center" ? TextHorizontalAlignment.center
                    : TextHorizontalAlignment.left;
            }
        }

        if root.it.kind == "table" && root.head: Rectangle {
            height: 1px;
            background: Theme.hairline;
        }

        // A link of the block above, as a chip that opens it.
        if root.it.kind == "link": HorizontalLayout {
            padding-left: root.indent;
            alignment: start;
            Buttons {
                list: root.it.buttons;
                key: root.it.key;
                button(k, id, x, t, b) => {
                    root.button(k, id, x, t, b);
                }
            }
        }

        if root.it.kind == "thinking": HorizontalLayout {
            padding-left: root.indent;
            spacing: Theme.sp-2;
            alignment: start;
            Dots { }
            Text {
                text: root.it.text;
                font-size: Theme.row;
                color: Theme.label-2;
                vertical-alignment: center;
            }
        }

        // Under an answer or a run: its buttons, then the quiet usage line.
        if root.it.kind == "meta": HorizontalLayout {
            padding-left: root.indent;
            spacing: Theme.sp-2;
            Buttons {
                list: root.it.buttons;
                key: root.it.key;
                button(k, id, x, t, b) => {
                    root.button(k, id, x, t, b);
                }
            }
            Text {
                text: root.it.sub;
                font-size: Theme.meta;
                color: Theme.label-3;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        // An error (or a busy note, or Start over's row) with its fixes.
        if root.it.kind == "error" || root.it.kind == "note": Rectangle {
            background: Theme.fill-1;
            border-radius: Theme.r-card;
            VerticalLayout {
                padding: Theme.sp-3;
                spacing: Theme.sp-2;
                HorizontalLayout {
                    spacing: Theme.sp-2;
                    if root.it.marker != "": Text {
                        text: root.it.marker;
                        width: 18px * Theme.text-scale;
                        font-family: Theme.icons;
                        font-size: 14px * Theme.text-scale;
                        color: root.it.state == "error" ? Theme.danger : Theme.label-2;
                        vertical-alignment: top;
                    }
                    Words {
                        horizontal-stretch: 1;
                        text: root.it.text;
                        font-size: Theme.row;
                    }
                }
                if root.it.buttons.length > 0: HorizontalLayout {
                    alignment: start;
                    Buttons {
                        list: root.it.buttons;
                        key: root.it.key;
                        button(k, id, x, t, b) => {
                            root.button(k, id, x, t, b);
                        }
                    }
                }
            }
        }

        if root.it.kind == "empty": Text {
            text: root.it.text;
            font-size: Theme.row;
            color: Theme.label-3;
            horizontal-alignment: center;
        }

        // What was sent with a question.
        if root.it.kind == "sent": Rectangle {
            background: Theme.plate;
            border-radius: Theme.r-plate;
            VerticalLayout {
                padding: Theme.sp-3;
                spacing: Theme.sp-1;
                Text {
                    text: root.it.text;
                    wrap: word-wrap;
                    font-size: Theme.caption;
                    font-weight: 600;
                    color: Theme.label-2;
                }
                for l in root.it.lines: Text {
                    text: "\u{2022} " + l;
                    wrap: word-wrap;
                    font-size: Theme.caption;
                    color: Theme.label-2;
                }
                if root.it.note != "": Text {
                    text: root.it.note;
                    wrap: word-wrap;
                    font-size: Theme.meta;
                    color: Theme.label-3;
                }
                if root.it.buttons.length > 0: HorizontalLayout {
                    alignment: start;
                    Buttons {
                        list: root.it.buttons;
                        key: root.it.key;
                        button(k, id, x, t, b) => {
                            root.button(k, id, x, t, b);
                        }
                    }
                }
                if root.it.picture.width > 0: Image {
                    source: root.it.picture;
                    height: 220px * Theme.text-scale;
                    image-fit: contain;
                }
            }
        }

        if root.it.kind == "trail-head": HorizontalLayout {
            padding-left: root.indent;
            spacing: Theme.sp-2;
            Text {
                text: root.it.text;
                font-size: Theme.caption;
                font-weight: 600;
                color: Theme.label-2;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Buttons {
                list: root.it.buttons;
                key: root.it.key;
                button(k, id, x, t, b) => {
                    root.button(k, id, x, t, b);
                }
            }
        }

        // A plan item, an act under it, or a row of its own in the trail.
        if root.it.kind == "step": HorizontalLayout {
            padding-left: root.indent;
            spacing: Theme.sp-2;
            Text {
                text: root.it.marker;
                width: 18px * Theme.text-scale;
                font-size: root.it.strong ? Theme.row : Theme.caption;
                color: root.mark-color;
                horizontal-alignment: center;
                vertical-alignment: top;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: root.it.text;
                    wrap: word-wrap;
                    font-size: root.it.strong ? Theme.row : Theme.caption;
                    color: root.it.strong ? Theme.label : Theme.label-2;
                }
                if root.it.note != "": Text {
                    text: root.it.note;
                    wrap: word-wrap;
                    font-size: Theme.meta;
                    color: root.it.state == "failed" ? Theme.danger : root.it.accent ? Theme.accent-text : Theme.label-3;
                }
            }
            if root.it.sub != "": Text {
                text: root.it.sub;
                font-size: Theme.meta;
                color: root.it.state == "failed" ? Theme.danger : Theme.label-3;
                vertical-alignment: top;
            }
        }

        // The confirm card, and the consent sheet: what it asks, the exact
        // text it would type, why it asks, and the answers.
        if root.it.kind == "card": Rectangle {
            background: Theme.raised;
            border-radius: Theme.r-card;
            VerticalLayout {
                padding: Theme.sp-4;
                spacing: Theme.sp-2;
                Text {
                    text: root.it.text;
                    wrap: word-wrap;
                    font-size: Theme.body-size;
                    font-weight: 600;
                    color: Theme.label;
                }
                if root.it.sub != "": HorizontalLayout {
                    Text {
                        text: root.it.sub;
                        font-size: Theme.row;
                        font-weight: 700;
                        color: Theme.label;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.it.extra;
                        wrap: word-wrap;
                        font-size: Theme.row;
                        color: Theme.label-2;
                    }
                }
                for l in root.it.lines: HorizontalLayout {
                    spacing: Theme.sp-2;
                    Text {
                        text: "\u{2022}";
                        font-size: Theme.row;
                        color: Theme.label-2;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: l;
                        wrap: word-wrap;
                        font-size: Theme.row;
                        color: Theme.label-2;
                    }
                }
                if root.it.value != "": Rectangle {
                    background: Theme.plate;
                    border-radius: Theme.r-row;
                    clip: true;
                    height: min(typed.preferred-height + 2 * Theme.sp-2, root.it.state == "all" ? 100000px : 8 * 20px * Theme.text-scale + 2 * Theme.sp-2);
                    typed := Words {
                        x: Theme.sp-2;
                        y: Theme.sp-2;
                        width: parent.width - 2 * Theme.sp-2;
                        text: root.it.value;
                        font-family: Theme.mono;
                        font-size: Theme.code;
                    }
                }
                if root.it.note != "": Text {
                    text: root.it.note;
                    wrap: word-wrap;
                    font-size: Theme.caption;
                    color: Theme.label-2;
                }
                HorizontalLayout {
                    alignment: end;
                    Buttons {
                        list: root.it.buttons;
                        key: root.it.key;
                        button(k, id, x, t, b) => {
                            root.button(k, id, x, t, b);
                        }
                    }
                }
            }
        }

        // Paused, or a plan waiting for Start.
        if root.it.kind == "banner": Rectangle {
            background: Theme.fill-1;
            border-radius: Theme.r-card;
            HorizontalLayout {
                padding: Theme.sp-3;
                spacing: Theme.sp-3;
                Words {
                    horizontal-stretch: 1;
                    text: root.it.text;
                    font-size: Theme.row;
                }
                Buttons {
                    list: root.it.buttons;
                    key: root.it.key;
                    button(k, id, x, t, b) => {
                        root.button(k, id, x, t, b);
                    }
                }
            }
        }

        // A run reopened from history: its steps, folded.
        if root.it.kind == "stored": VerticalLayout {
            spacing: Theme.sp-2;
            HorizontalLayout {
                alignment: start;
                Buttons {
                    list: root.it.buttons;
                    key: root.it.key;
                    button(k, id, x, t, b) => {
                        root.button(k, id, x, t, b);
                    }
                }
            }
            if root.it.value != "": Rectangle {
                background: Theme.plate;
                border-radius: Theme.r-plate;
                VerticalLayout {
                    padding: Theme.sp-3;
                    Words {
                        text: root.it.value;
                        font-family: Theme.mono;
                        font-size: Theme.code;
                    }
                }
            }
        }
    }
}

component MenuItem inherits Rectangle {
    in property <OutMenuRow> r;
    in property <bool> marked;
    callback picked();
    height: (root.r.header ? 28px : 36px) * Theme.text-scale;

    if root.r.header: Text {
        x: Theme.sp-3;
        width: parent.width - 2 * Theme.sp-3;
        height: parent.height;
        text: root.r.text;
        font-size: Theme.meta;
        color: Theme.label-3;
        vertical-alignment: bottom;
        overflow: elide;
    }
    if !root.r.header: MenuRow {
        width: parent.width;
        height: parent.height;
        text: root.r.text;
        keys: root.r.note;
        selected: root.marked;
        checked: root.r.checked;
        clicked => {
            root.picked();
        }
    }
}

export component OutputWindow inherits Window {
    background: Theme.base;
    default-font-family: Theme.font;
    default-font-size: Theme.body-size;

    in property <[OutRow]> rows;
    in property <string> sheet-title: "Answer";
    in property <bool> task-kind: false;
    in property <bool> copy-all-shown: false;
    in property <bool> copy-all-done: false;
    // The bar's next question goes here (output:meta target, in panel mode).
    in property <bool> target: false;
    // Asked to go (output:away): drawn empty, so a hidden window keeps an
    // empty last frame.
    in property <bool> away: false;
    in property <string> hint;

    in property <bool> menu-open: false;
    in property <[OutMenuRow]> menu-rows;
    in property <int> menu-mark: -1;
    in property <string> menu-empty;
    in property <length> menu-x;
    in property <length> menu-top;
    in property <length> menu-bottom;

    // What the window needs to show everything: Rust sizes a window that
    // follows its transcript from this (output:glass).
    out property <length> content-height: bar.height + col.preferred-height;
    out property <length> scroll-top: -flick.content-y;
    out property <length> scroll-height: flick.content-height;
    out property <length> view-height: flick.height;
    out property <length> column-width: col.width;
    // Follows new words down unless the person scrolled up.
    in-out property <bool> stick: true;

    callback row-button(string, string, length, length, length);
    callback row-context(string);
    callback tool(string);
    callback drag();
    callback maximize();
    callback title-context(length, length);
    callback menu-picked(int);
    callback menu-close();
    callback height-changed(length);

    public function scroll-by(dy: length) {
        flick.content-y = max(min(0px, flick.height - flick.content-height), min(0px, flick.content-y - dy));
    }

    public function scroll-home() {
        flick.content-y = 0px;
    }

    public function scroll-end() {
        root.stick = true;
        flick.content-y = min(0px, flick.height - flick.content-height);
    }

    changed content-height => {
        root.height-changed(root.content-height);
    }
    changed scroll-height => {
        flick.content-y = root.stick ? min(0px, flick.height - flick.content-height) : max(min(0px, flick.height - flick.content-height), flick.content-y);
    }
    changed view-height => {
        flick.content-y = root.stick ? min(0px, flick.height - flick.content-height) : max(min(0px, flick.height - flick.content-height), flick.content-y);
    }
    changed scroll-top => {
        root.stick = root.scroll-top >= flick.content-height - flick.height - 48px;
    }

    sheet := Rectangle {
        visible: !root.away;
        width: root.width;
        height: root.height;

        VerticalLayout {
            // The title bar: held to move the window, double-clicked to
            // maximise it, right-clicked for the window menu.
            bar := Rectangle {
                height: 44px * Theme.text-scale;

                drag-touch := TouchArea {
                    property <bool> armed: false;
                    pointer-event(e) => {
                        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                            self.armed = true;
                        }
                        if (e.kind == PointerEventKind.up) {
                            self.armed = false;
                            if (e.button == PointerEventButton.right) {
                                root.title-context(self.mouse-x, self.mouse-y);
                            }
                        }
                    }
                    moved => {
                        if (self.armed && self.pressed) {
                            self.armed = false;
                            root.drag();
                        }
                    }
                    double-clicked => {
                        root.maximize();
                    }
                }

                HorizontalLayout {
                    padding-left: Theme.sp-4;
                    padding-right: Theme.sp-2;
                    padding-top: 8px * Theme.text-scale;
                    padding-bottom: 8px * Theme.text-scale;
                    spacing: Theme.sp-1;
                    Text {
                        text: root.task-kind ? Glyph.pointer : Glyph.bubble;
                        font-family: Theme.icons;
                        font-size: 14px * Theme.text-scale;
                        color: Theme.label-2;
                        vertical-alignment: center;
                        width: 22px * Theme.text-scale;
                    }
                    Text {
                        text: root.sheet-title;
                        font-size: Theme.caption;
                        font-weight: 600;
                        color: Theme.label;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if root.target: Text {
                        text: "\u{25CF}";
                        font-size: 8px * Theme.text-scale;
                        color: Theme.accent;
                        vertical-alignment: center;
                        width: 14px * Theme.text-scale;
                        horizontal-alignment: center;
                    }
                    if root.copy-all-shown: IconButton {
                        glyph: root.copy-all-done ? Glyph.check : Glyph.copy;
                        tip: "Copy conversation (Ctrl+Shift+C)";
                        size: 28px * Theme.text-scale;
                        glyph-size: 12px;
                        clicked => {
                            root.tool("copy-all");
                        }
                    }
                    IconButton {
                        glyph: Glyph.history;
                        tip: "History (Ctrl+H)";
                        size: 28px * Theme.text-scale;
                        glyph-size: 12px;
                        clicked => {
                            root.tool("history");
                        }
                    }
                    IconButton {
                        glyph: Glyph.add;
                        tip: "Start over";
                        size: 28px * Theme.text-scale;
                        glyph-size: 12px;
                        clicked => {
                            root.tool("new");
                        }
                    }
                    IconButton {
                        glyph: Glyph.minimize;
                        tip: "Minimize (Ctrl+M)";
                        size: 28px * Theme.text-scale;
                        glyph-size: 12px;
                        clicked => {
                            root.tool("minimize");
                        }
                    }
                    IconButton {
                        glyph: Glyph.close;
                        tip: "Close (Ctrl+W)";
                        size: 28px * Theme.text-scale;
                        glyph-size: 12px;
                        clicked => {
                            root.tool("close");
                        }
                    }
                }

                // A hairline only once the transcript scrolls beneath.
                Rectangle {
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.hairline;
                    visible: root.scroll-top > 2px;
                }
            }

            area := Rectangle {
                min-height: 0px;
                vertical-stretch: 1;

                flick := Flickable {
                    width: parent.width;
                    height: parent.height;
                    // The wheel scrolls; a drag selects text.
                    interactive: false;
                    content-width: self.width;
                    content-height: col.preferred-height;

                    col := VerticalLayout {
                        // The reading measure: 640 px, centred once wider.
                        width: min(flick.width, 640px * Theme.text-scale + 2 * Theme.sp-5);
                        x: max(0px, (flick.width - self.width) / 2);
                        height: self.preferred-height;
                        padding-left: Theme.sp-5;
                        padding-right: Theme.sp-5;
                        padding-top: Theme.sp-1;
                        padding-bottom: Theme.sp-5;

                        for row in root.rows: RowView {
                            it: row;
                            button(k, id, x, t, b) => {
                                root.row-button(k, id, x, t, b);
                            }
                            context(k) => {
                                root.row-context(k);
                            }
                        }
                    }
                }

                // The scroll thumb: visible whenever there is more than fits.
                thumb := Rectangle {
                    property <length> over: flick.content-height - flick.height;
                    visible: self.over > 1px;
                    width: thumb-touch.has-hover || thumb-touch.pressed ? 8px : 4px;
                    x: parent.width - self.width - 3px;
                    height: max(32px, flick.height * (flick.height / max(1px, flick.content-height)));
                    y: self.over > 0px ? (-flick.content-y) / self.over * (flick.height - self.height) : 0px;
                    border-radius: self.width / 2;
                    background: thumb-touch.pressed ? Theme.label-3 : Theme.fill-3;

                    thumb-touch := TouchArea {
                        moved => {
                            if (self.pressed) {
                                flick.content-y = max(0px - thumb.over, min(0px, flick.content-y - (self.mouse-y - self.pressed-y) * (thumb.over / max(1px, flick.height - thumb.height))));
                            }
                        }
                    }
                }
            }
        }

        // Move and Size from the keyboard say what the arrows do.
        if root.hint != "": Rectangle {
            x: Theme.sp-3;
            y: root.height - self.height - Theme.sp-3;
            width: root.width - 2 * Theme.sp-3;
            height: 36px * Theme.text-scale;
            border-radius: Theme.r-row;
            background: Theme.raised;
            Text {
                text: root.hint;
                font-size: Theme.caption;
                color: Theme.label;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // A menu (Retry with another model, the window menu): under its
    // button, or above it when there is no room below, never cut by the
    // window's edge; past both it scrolls.
    if root.menu-open: Rectangle {
        width: root.width;
        height: root.height;

        TouchArea {
            clicked => {
                root.menu-close();
            }
        }

        panel := Rectangle {
            width: min(root.width - 16px, 280px * Theme.text-scale);
            height: min(menu-col.preferred-height, root.height - 16px);
            x: max(8px, min(root.menu-x, root.width - self.width - 8px));
            y: root.menu-bottom + 4px + self.height <= root.height - 8px ? root.menu-bottom + 4px : max(8px, root.menu-top - 4px - self.height);
            background: Theme.raised;
            border-radius: Theme.r-card;
            drop-shadow-blur: 24px;
            drop-shadow-color: #5A3A3A33;
            clip: true;

            TouchArea { }

            Flickable {
                width: parent.width;
                height: parent.height;
                interactive: false;
                content-width: self.width;
                content-height: menu-col.preferred-height;

                menu-col := VerticalLayout {
                    width: panel.width;
                    height: self.preferred-height;
                    padding: Theme.sp-1;

                    if root.menu-rows.length == 0: Text {
                        text: root.menu-empty;
                        height: 36px * Theme.text-scale;
                        font-size: Theme.row;
                        color: Theme.label-3;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    for r[i] in root.menu-rows: MenuItem {
                        r: r;
                        marked: i == root.menu-mark;
                        picked => {
                            root.menu-picked(i);
                        }
                    }
                }
            }
        }
    }
}
