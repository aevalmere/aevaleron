// The see-through overlays (src/ui/overlays.rs): the dictation pill, the
// area picker, the lens and the buddy, one file each; and the blank page
// for any page path with no native page.
import { Theme } from "theme.slint";

export { VoicePillWindow } from "overlay-pill.slint";
export { RegionWindow } from "overlay-region.slint";
export { LensWindow } from "overlay-lens.slint";
export { BuddyWindow, BuddyAction } from "overlay-buddy.slint";

// A window whose page has no native port: nothing is drawn.
export component BlankWindow inherits Window {
    background: transparent;
    default-font-family: Theme.font;
}
